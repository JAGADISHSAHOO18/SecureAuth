# Copy this file to .env for Docker Compose.
# Never commit the real .env file.
DB_PASSWORD=root
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters-for-local-docker
APP_ADMIN_EMAIL=admin@example.com

# Google OAuth2 (optional until OAuth apps are created)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth2 (optional until OAuth apps are created)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional ports
MYSQL_HOST_PORT=3307
